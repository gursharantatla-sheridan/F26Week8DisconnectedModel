<Window x:Class="F26Week8DisconnectedModel.DataSetWithMultipleTables"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:F26Week8DisconnectedModel"
        mc:Ignorable="d"
        Title="DataSetWithMultipleTables" Height="450" Width="800">
    <Canvas>
        <Button x:Name="btnLoad" Content="Load Data" HorizontalAlignment="Left" VerticalAlignment="Center" Height="53" Width="118" Canvas.Left="25" Canvas.Top="23" FontSize="14" FontWeight="Bold" Click="btnLoad_Click"/>
        <DataGrid x:Name="grdCategories" d:ItemsSource="{d:SampleData ItemCount=5}" Canvas.Left="25" Canvas.Top="97" HorizontalAlignment="Left" Height="283" VerticalAlignment="Center" Width="360"/>
        <DataGrid x:Name="grdProducts" d:ItemsSource="{d:SampleData ItemCount=5}" Canvas.Left="415" Canvas.Top="97" HorizontalAlignment="Left" Height="283" VerticalAlignment="Center" Width="356"/>
    </Canvas>
</Window>
